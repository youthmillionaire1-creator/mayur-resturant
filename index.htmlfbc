        </div>
      </div>

      <a class="btn-primary" href="https://wa.me/919876543210" target="_blank" style="margin-top:8px;display:inline-block;">💬 WhatsApp Us</a>
    </div>

    <div class="reveal">
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3671.8939338847344!2d72.5612!3d23.0258!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395e84f924f6de03%3A0x27a3e8c5e8b2a08c!2sNavrangpura%2C%20Ahmedabad%2C%20Gujarat!5e0!3m2!1sen!2sin!4v1620000000000!5m2!1sen!2sin"
          allowfullscreen="" loading="lazy">
        </iframe>
      </div>
      <p style="margin-top:16px;color:var(--text-muted);font-size:0.83rem;">📌 Near Navrangpura Metro Station · Free parking available</p>
    </div>
  </section>
</div>

<!-- WhatsApp Float -->
<a class="whatsapp-float" href="https://wa.me/919876543210" target="_blank" title="Chat on WhatsApp">💬</a>

<!-- Order Modal -->
<div class="modal-overlay" id="order-modal">
  <div class="modal">
    <button class="modal-close" onclick="closeOrderModal()">✕</button>
    <h2>Order Online</h2>
    <p>Choose your preferred platform or call us directly.</p>
    <div class="modal-btns">
      <a class="modal-btn" href="https://www.swiggy.com" target="_blank"><span>🧡</span> Order on Swiggy</a>
      <a class="modal-btn" href="https://www.zomato.com" target="_blank"><span>❤️</span> Order on Zomato</a>
