    </div>
  </div>
</div>

<!-- Footer -->
<footer style="position:relative;z-index:1;">
  <div class="footer-logo">Mayur Restaurant</div>
  <div class="footer-links">
    <a onclick="showSection('home')">Home</a>
    <a onclick="showSection('menu')">Menu</a>
    <a onclick="showSection('gallery')">Gallery</a>
    <a onclick="showSection('reviews')">Reviews</a>
    <a onclick="showSection('contact')">Contact</a>
  </div>
  <div class="footer-copy">© 2025 Mayur Restaurant, Ahmedabad. All rights reserved. Crafted with ❤️ in Gujarat.</div>
</footer>

<!-- ════════════════ SCRIPTS ════════════════ -->
<script>
// ── THREE.JS 3D BACKGROUND ──
(function() {
  const canvas = document.getElementById('bg-canvas');
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
  camera.position.z = 5;

  // Floating particles
  const geo = new THREE.BufferGeometry();
  const count = 800;
  const positions = new Float32Array(count * 3);
  const colors = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 30;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 20;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 15;
    const t = Math.random();
    if (t < 0.5) {
      colors[i * 3] = 0.83; colors[i * 3 + 1] = 0.63; colors[i * 3 + 2] = 0.09; // gold
    } else {
      colors[i * 3] = 0.55; colors[i * 3 + 1] = 0.10; colors[i * 3 + 2] = 0.10; // crimson
    }
  }
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  const mat = new THREE.PointsMaterial({ size: 0.06, vertexColors: true, transparent: true, opacity: 0.65 });
  const particles = new THREE.Points(geo, mat);
  scene.add(particles);

  // Floating tori (rings)
  const torii = [];
  const torusMat = new THREE.MeshBasicMaterial({ color: 0xD4A017, wireframe: true, opacity: 0.12, transparent: true });
  for (let i = 0; i < 5; i++) {
    const torus = new THREE.Mesh(new THREE.TorusGeometry(1.5 + i * 0.8, 0.04, 8, 60), torusMat);
    torus.position.set((Math.random() - 0.5) * 14, (Math.random() - 0.5) * 8, (Math.random() - 0.5) * 5 - 5);
    torus.rotation.x = Math.random() * Math.PI;
    torus.rotation.y = Math.random() * Math.PI;
    scene.add(torus);
    torii.push(torus);
  }

  // Mouse parallax
  let mx = 0, my = 0;
  document.addEventListener('mousemove', e => {
    mx = (e.clientX / window.innerWidth - 0.5) * 0.8;
    my = (e.clientY / window.innerHeight - 0.5) * 0.5;
  });

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  let t = 0;
  function animate() {
    requestAnimationFrame(animate);
    t += 0.004;
    particles.rotation.y += 0.0008;
    particles.rotation.x += 0.0003;
    torii.forEach((tor, i) => {
      tor.rotation.x += 0.003 + i * 0.001;
      tor.rotation.y += 0.002 + i * 0.0005;
      tor.position.y += Math.sin(t + i) * 0.003;
    });
    camera.position.x += (mx - camera.position.x) * 0.04;
    camera.position.y += (-my - camera.position.y) * 0.04;
    renderer.render(scene, camera);
  }
  animate();
})();

// ── MENU DATA ──
const menuItems = [
  { cat: 'starters', name: 'Paneer Tikka', desc: 'Marinated cottage cheese grilled in tandoor with spices', price: 180, icon: '🧀', veg: true },
  { cat: 'starters', name: 'Veg Spring Rolls', desc: 'Crispy rolls stuffed with mixed vegetables & noodles', price: 120, icon: '🥟', veg: true },
  { cat: 'starters', name: 'Chicken 65', desc: 'Spicy deep-fried chicken with curry leaves & chilies', price: 210, icon: '🍗', veg: false },
  { cat: 'starters', name: 'Onion Bhajia', desc: 'Crispy golden fritters with green chutney', price: 90, icon: '🧅', veg: true },
  { cat: 'main', name: 'Dal Makhani', desc: 'Slow-cooked black lentils in creamy tomato butter sauce', price: 160, icon: '🫘', veg: true },
  { cat: 'main', name: 'Butter Chicken', desc: 'Tender chicken in rich tomato-cream gravy', price: 280, icon: '🍛', veg: false },
  { cat: 'main', name: 'Paneer Butter Masala', desc: 'Soft paneer in silky, aromatic butter masala', price: 220, icon: '🟡', veg: true },
  { cat: 'main', name: 'Veg Biryani', desc: 'Fragrant basmati rice with seasonal vegetables & saffron', price: 180, icon: '🍚', veg: true },
  { cat: 'main', name: 'Mutton Rogan Josh', desc: 'Slow-braised mutton in Kashmiri spices', price: 340, icon: '🥩', veg: false },
  { cat: 'chinese', name: 'Veg Hakka Noodles', desc: 'Stir-fried noodles with fresh vegetables & soy sauce', price: 140, icon: '🍜', veg: true },
  { cat: 'chinese', name: 'Chilli Chicken', desc: 'Indo-Chinese classic with peppers & soy', price: 240, icon: '🌶️', veg: false },
  { cat: 'chinese', name: 'Veg Fried Rice', desc: 'Wok-tossed rice with vegetables & scrambled egg', price: 130, icon: '🥡', veg: true },
  { cat: 'chinese', name: 'Manchurian Gravy', desc: 'Crispy veg balls in tangy Manchurian sauce', price: 160, icon: '🥣', veg: true },
  { cat: 'beverages', name: 'Mango Lassi', desc: 'Thick creamy yogurt shake with Alphonso mango', price: 80, icon: '🥭', veg: true },
  { cat: 'beverages', name: 'Masala Chai', desc: 'Aromatic spiced Indian tea with ginger & cardamom', price: 40, icon: '☕', veg: true },
  { cat: 'beverages', name: 'Fresh Lime Soda', desc: 'Refreshing lime with soda, sweet or salted', price: 60, icon: '🍋', veg: true },
  { cat: 'beverages', name: 'Rose Sharbat', desc: 'Chilled rose syrup drink with basil seeds', price: 70, icon: '🌹', veg: true },
];

function renderMenu(filter) {
  const grid = document.getElementById('menu-grid');
  const items = filter === 'all' ? menuItems : menuItems.filter(i => i.cat === filter);
  grid.innerHTML = items.map(item => `
    <div class="menu-card">
      <div class="menu-card-img">
        ${item.icon}
        <div class="${item.veg ? 'veg-badge' : 'nonveg-badge'}">
          <div class="${item.veg ? 'veg-dot' : 'nonveg-dot'}"></div>
        </div>
      </div>
      <div class="menu-card-body">
        <h3>${item.name}</h3>
        <p>${item.desc}</p>
        <div class="menu-card-footer">
          <span class="price">₹${item.price}</span>
          <button class="add-btn" onclick="openOrderModal()">Order +</button>
        </div>
      </div>
    </div>
  `).join('');
}

function filterMenu(cat, btn) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderMenu(cat);
}

// ── REVIEWS DATA ──
const reviews = [
  { name: 'Priya Shah', loc: 'Navrangpura, Ahmedabad', rating: 5, text: 'Best paneer tikka I have ever had in Ahmedabad! The ambience is beautiful and the service is exceptional. Will definitely come back again and again.' },
  { name: 'Rahul Mehta', loc: 'Satellite, Ahmedabad', rating: 5, text: 'Visited for a family dinner and it was outstanding. The dal makhani melts in your mouth. Portions are generous and pricing is very reasonable.' },
  { name: 'Anjali Patel', loc: 'Bopal, Ahmedabad', rating: 5, text: 'The Butter Chicken here is something else! Rich, creamy and full of flavour. This is our family\'s go-to restaurant for celebrations.' },
  { name: 'Vikram Desai', loc: 'Vastrapur, Ahmedabad', rating: 4, text: 'Great Chinese section — the Hakka noodles are perfectly cooked. Staff is very friendly. The 3D decor inside is stunning. Highly recommend!' },
  { name: 'Sneha Joshi', loc: 'Thaltej, Ahmedabad', rating: 5, text: 'Ordered via Swiggy and the biryani arrived piping hot. Packed beautifully with all accompaniments. Quality never disappoints. 5 stars always!' },
  { name: 'Arjun Kapoor', loc: 'Maninagar, Ahmedabad', rating: 5, text: 'The mango lassi alone is worth the visit! Everything on the menu is fresh and authentic. You can taste the love put into every dish.' },
];

function renderReviews() {
  document.getElementById('reviews-grid').innerHTML = reviews.map(r => `
    <div class="review-card">
      <div class="stars">${'★'.repeat(r.rating)}${'☆'.repeat(5 - r.rating)}</div>
      <p class="review-text">${r.text}</p>
      <div class="review-author">
        <div class="author-avatar">${r.name[0]}</div>
        <div>
          <div class="author-name">${r.name}</div>
          <div class="author-loc">📍 ${r.loc}</div>
        </div>
      </div>
    </div>
  `).join('');
}

// ── NAVIGATION ──
function showSection(name) {
  document.querySelectorAll('.page-section').forEach(s => s.classList.remove('active'));
  document.getElementById(name + '-section').classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
  // init content
  if (name === 'menu') renderMenu('all');
  if (name === 'reviews') renderReviews();
  // trigger reveals
  setTimeout(triggerReveal, 100);
}

// ── MODAL ──
function openOrderModal() {
  document.getElementById('order-modal').classList.add('active');
}
function closeOrderModal() {
  document.getElementById('order-modal').classList.remove('active');
}
document.getElementById('order-modal').addEventListener('click', e => {
  if (e.target === e.currentTarget) closeOrderModal();
});

// ── REVEAL ON SCROLL ──
function triggerReveal() {
  const els = document.querySelectorAll('.reveal');
  els.forEach(el => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight - 60) el.classList.add('visible');
  });
}
window.addEventListener('scroll', triggerReveal);
triggerReveal();

// ── INIT ──
renderMenu('all');
renderReviews();
</script>
</body>
</html>
